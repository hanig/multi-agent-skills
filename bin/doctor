#!/bin/sh
# doctor — what is installed here, where it came from, and whether it still works.
#
# First thing to run on a new host, and the answer to "why isn't my skill
# loading?". Read-only.
#
# Usage: doctor [--prefix DIR] | doctor DIR
#
# install.sh spells the install root --prefix and doctor took it positionally,
# so the line install.sh prints to verify an install was wrong for any prefix
# but the default -- it checked ~/.claude/skills whatever you had just
# installed into. --prefix is now the spelling both take. The positional form
# still works: it is in scripts and in shell history, and breaking it would
# buy nothing.

set -u

PREFIX="${HOME}/.claude/skills"
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix) PREFIX="$2"; shift 2 ;;
    -h|--help)
      printf '%s\n' \
        'doctor — what is installed here, where it came from, and whether it still works.' \
        '' \
        'First thing to run on a new host, and the answer to "why isn'"'"'t my skill' \
        'loading?". Read-only.' \
        '' \
        'Usage: doctor [--prefix DIR] | doctor DIR'
      exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) PREFIX="$1"; shift ;;
  esac
done
MARKER=".installed-by-multi-agent-skills"
# The authorship namespace: this repo writes hanig-*, and vendors everything
# else it ships. Same rule install.sh classifies by, read off the tree.
OWN_PREFIX="hanig-"

case "$0" in */*) SCRIPT_DIR=${0%/*} ;; *) SCRIPT_DIR=. ;; esac
REPO=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

# A probe that can hang is worse than no probe: this is the first command run
# on a new host, often over a link that is why you are running it. Perl is the
# execution substrate for bounded children, just as Python is the execution
# substrate for survey.py's run()/REAP_SECONDS. Its monotonic clock, nonblocking
# wait and in-process sleep need no mktemp/sleep/rm helpers of their own. If the
# substrate is absent, no diagnostic child is launched and the answer is
# unknown; an unbounded fallback would recreate the bug this function exists
# to close.
#
# The direct command gets its own process group. Timeout is a one-way latch:
# TERM is followed at one absolute grace deadline by KILL of the original
# group, even if the direct child exited after TERM. The direct child is polled
# for reaping but never waited on without a bound. That cleans up ordinary
# profile children from bash -lic. A descendant that deliberately leaves the
# group, or a direct child parked in an uninterruptible syscall, can survive;
# neither can make doctor wait past the grace deadline. Arbitrary descendant
# quiescence is not a guarantee a portable diagnostic can honestly make.
#
# Output is not the completion signal: py_compile says nothing on success, and
# silence is not a timeout. RUN_SECONDS is the ordinary command deadline.
# PROBE_RUN_SECONDS is looser because the health probe can spend PROBE_SECONDS
# first connecting and then reading.
PROBE_SECONDS=2
RUN_SECONDS=3
PROBE_RUN_SECONDS=6
REAP_SECONDS=2

PERL=
if command -v perl >/dev/null 2>&1; then PERL=perl; fi

# One supervisor invocation produces exactly three lines: state, return code,
# and the last output line. It retains only the tail of a noisy child's output
# and never waits for pipe EOF after the direct child finishes: a surviving
# descendant may still own the writer.
SUPERVISOR_PERL='use strict;
use warnings;
use POSIX qw(:sys_wait_h :signal_h setpgid sigprocmask _exit);
use Time::HiRes qw(clock_gettime CLOCK_MONOTONIC sleep);
use Fcntl qw(F_GETFL F_SETFL F_SETFD O_NONBLOCK FD_CLOEXEC);
use Errno qw(EINTR);

my ($limit, $reap, @cmd) = @ARGV;
sub answer {
    my ($state, $rc, $line) = @_;
    $line = "" unless defined $line;
    $line =~ s/\0//g;
    $line =~ s/[\r\n]+\z//;
    $line = (split /\n/, $line, -1)[-1] // "";
    # Command substitution strips trailing newlines. A final non-empty record
    # preserves an intentionally empty third field (successful silent child).
    print "$state\n$rc\n$line\n__DOCTOR_END__";
    exit 0;
}

# Configure every pipe before fork. A setup failure therefore cannot leave a
# launched diagnostic behind. The setup writer closes atomically on exec.
pipe(my $reader, my $writer) or answer("unknown", 127, "output pipe");
pipe(my $setup_reader, my $setup_writer)
    or answer("unknown", 127, "setup pipe");
my $flags = fcntl($reader, F_GETFL, 0);
answer("unknown", 127, "output pipe flags") unless defined $flags;
fcntl($reader, F_SETFL, $flags | O_NONBLOCK)
    or answer("unknown", 127, "output pipe nonblocking mode");
my $setup_flags = fcntl($setup_reader, F_GETFL, 0);
answer("unknown", 127, "setup pipe flags") unless defined $setup_flags;
fcntl($setup_reader, F_SETFL, $setup_flags | O_NONBLOCK)
    or answer("unknown", 127, "setup pipe nonblocking mode");
fcntl($setup_writer, F_SETFD, FD_CLOEXEC)
    or answer("unknown", 127, "setup close-on-exec mode");

my $blocked_signals = POSIX::SigSet->new(SIGHUP, SIGINT, SIGTERM);
my $old_signal_mask = POSIX::SigSet->new();
sigprocmask(SIG_BLOCK, $blocked_signals, $old_signal_mask)
    or answer("unknown", 127, "signal mask");
# This supervisor is single-threaded and is sole reaper for the direct child.
# Clear an inherited ignored/no-cld-wait disposition before launch. Therefore
# a later non-EINTR wait error does not mean some other reaper released the
# PID/PGID identity that bounded cleanup still holds.
eval { $SIG{CHLD} = "DEFAULT"; 1 }
    or answer("unknown", 127, "SIGCHLD disposition");
my $active_pid = 0;
my $interrupted = "";
for my $signal_name (qw(HUP INT TERM)) {
    $SIG{$signal_name} = sub {
        return unless $active_pid;
        return if length $interrupted;
        $interrupted = $_[0];
    };
}

my $SETUP_EXIT = 125;
my $pid = fork();
answer("unknown", 127, "fork") unless defined $pid;
if ($pid == 0) {
    close $reader;
    close $setup_reader;
    my $write_setup = sub {
        my ($message) = @_;
        $message .= "\n";
        while (length $message) {
            my $n = syswrite($setup_writer, $message);
            next if !defined($n) && $! == EINTR;
            return 0 unless defined($n) && $n > 0;
            substr($message, 0, $n, "");
        }
        return 1;
    };
    for my $signal_name (qw(HUP INT TERM)) {
        $SIG{$signal_name} = "DEFAULT";
    }
    unless (sigprocmask(SIG_SETMASK, $old_signal_mask)) {
        $write_setup->("error:signal-mask");
        _exit($SETUP_EXIT);
    }
    my $grouped = setpgid(0, 0);
    unless (defined $grouped) {
        $write_setup->("error:setpgid");
        _exit($SETUP_EXIT);
    }
    unless (open STDOUT, ">&", $writer) {
        $write_setup->("error:stdout");
        _exit($SETUP_EXIT);
    }
    unless (open STDERR, ">&", $writer) {
        $write_setup->("error:stderr");
        _exit($SETUP_EXIT);
    }
    close $writer;
    # A command can execute only after this complete handshake. Thus absence
    # of ready is a setup failure without reserving any command exit status.
    $write_setup->("ready") or _exit($SETUP_EXIT);
    exec {$cmd[0]} @cmd or do {
        $write_setup->("error:exec");
        _exit($SETUP_EXIT);
    };
}
close $writer;
close $setup_writer;
$active_pid = $pid;
unless (sigprocmask(SIG_SETMASK, $old_signal_mask)) {
    kill "TERM", -$pid;
    kill "TERM", $pid;
    kill "KILL", -$pid;
    kill "KILL", $pid;
    waitpid($pid, WNOHANG);
    answer("unknown", 127, "signal mask restore");
}

my $started = clock_gettime(CLOCK_MONOTONIC);
my $run_deadline = $started + $limit;
my $grace_deadline = $run_deadline + $reap;
my $state = "RUNNING";
my ($status, $direct_reaped);
my $tail = "";
my $setup_error = "";
my $wait_error = "";
my $cleanup_deadline;
my $DRAIN_READS = 8;
my $DRAIN_BYTES = 65536;
sub drain {
    my ($reads, $bytes) = (0, 0);
    while ($reads < $DRAIN_READS && $bytes < $DRAIN_BYTES) {
        $reads++;
        my $chunk = "";
        my $want = $DRAIN_BYTES - $bytes;
        $want = 8192 if $want > 8192;
        my $n = sysread($reader, $chunk, $want);
        next if !defined($n) && $! == EINTR;
        last unless defined($n) && $n > 0;
        $bytes += $n;
        $tail .= $chunk;
        $tail = substr($tail, -65536) if length($tail) > 65536;
    }
}
sub drain_setup {
    for (1 .. 4) {
        my $chunk = "";
        my $n = sysread($setup_reader, $chunk, 256);
        next if !defined($n) && $! == EINTR;
        last unless defined($n) && $n > 0;
        $setup_error .= $chunk;
        $setup_error = substr($setup_error, -1024)
            if length($setup_error) > 1024;
    }
}

while (1) {
    drain();
    drain_setup();
    my $now = clock_gettime(CLOCK_MONOTONIC);

    if (length($interrupted) && !$active_pid) {
        answer("supervisor-error", 127,
               "interrupted by SIG$interrupted; termination was attempted");
    }
    if (length($interrupted) && !defined($cleanup_deadline)) {
        $cleanup_deadline = $now + $reap;
        kill "TERM", -$active_pid if $active_pid;
        kill "TERM", $active_pid if $active_pid;
    }

    if ($state eq "RUNNING" && !$wait_error && $now >= $run_deadline) {
        $state = "TIMED_OUT";
        $cleanup_deadline = $grace_deadline
            unless defined $cleanup_deadline;
        kill "TERM", -$active_pid if $active_pid;
        kill "TERM", $active_pid if $active_pid;
    }

    unless ($direct_reaped || defined $cleanup_deadline) {
        my $poll_mask = POSIX::SigSet->new();
        unless (sigprocmask(SIG_BLOCK, $blocked_signals, $poll_mask)) {
            $wait_error = "could not mask signals around waitpid: $!"
                unless length $wait_error;
            $cleanup_deadline = $now + $reap
                unless defined $cleanup_deadline;
            kill "TERM", -$active_pid if $active_pid;
            kill "TERM", $active_pid if $active_pid;
            next;
        }
        if (length $interrupted) {
            # The signal was observed before completion. Do not reap and free
            # the identity that the next loop iteration will clean up.
            unless (sigprocmask(SIG_SETMASK, $poll_mask)) {
                $wait_error = "could not restore signals before cleanup: $!"
                    unless length $wait_error;
            }
            next;
        }
        my $got = waitpid($pid, WNOHANG);
        if ($got == $pid) {
            $status = $?;
            $direct_reaped = 1;
            $active_pid = 0;
            $interrupted = "";
        }
        my $poll_errno_number = 0 + $!;
        unless (sigprocmask(SIG_SETMASK, $poll_mask)) {
            $wait_error = "could not restore signals after waitpid: $!"
                unless length $wait_error;
            if ($active_pid) {
                $cleanup_deadline = $now + $reap
                    unless defined $cleanup_deadline;
                kill "TERM", -$active_pid;
                kill "TERM", $active_pid;
            }
        }
        if ($got == $pid) {
            drain_setup();
            # The active PID was cleared while interruption signals were
            # blocked. Any pending signal is delivered only after restoration
            # and can therefore never act on a reaped/reusable identity.
            last;
        } elsif ($got == -1 && $poll_errno_number != EINTR && !$wait_error) {
            $! = $poll_errno_number;
            $wait_error = "waitpid failed: $!";
            $cleanup_deadline = $now + $reap
                unless defined $cleanup_deadline;
            kill "TERM", -$active_pid if $active_pid;
            kill "TERM", $active_pid if $active_pid;
        }
    }

    if (defined($cleanup_deadline) && $now >= $cleanup_deadline) {
        # The group may still contain a TERM-ignoring child after its parent
        # exited. Keep that parent unreaped to reserve its PID/PGID, signal the
        # original group at grace, and only then make the final reap attempt.
        kill "KILL", -$active_pid if $active_pid;
        kill "KILL", $active_pid if $active_pid;
        unless ($direct_reaped) {
            # One final nonblocking attempt only. EINTR or any other failure
            # cannot extend the already-expired cleanup deadline.
            my $last = waitpid($pid, WNOHANG);
            my $last_errno_number = 0 + $!;
            if ($last == $pid) {
                $status = $?;
                $direct_reaped = 1;
                $active_pid = 0;
            } elsif ($last == -1 && $last_errno_number != EINTR
                     && !$wait_error) {
                $! = $last_errno_number;
                $wait_error = "final waitpid failed: $!";
            }
        }
        last;
    }
    sleep 0.02;
}
drain();
drain_setup();
if (length $interrupted) {
    answer("supervisor-error", 127,
           "interrupted by SIG$interrupted; termination was attempted");
}
if (length $wait_error) {
    answer("supervisor-error", 127, $wait_error);
}
if ($setup_error =~ /(?:^|\n)error:([^\n]+)/) {
    answer("setup-error", 127, $1);
}
if ($state eq "RUNNING" && $direct_reaped
        && $setup_error !~ /(?:^|\n)ready(?:\n|$)/) {
    answer("setup-error", 127, "setup handshake absent");
}
my $rc = 127;
if ($state eq "TIMED_OUT") {
    $rc = 124;
} elsif (defined $status) {
    $rc = WIFEXITED($status) ? WEXITSTATUS($status)
        : WIFSIGNALED($status) ? 128 + WTERMSIG($status) : 127;
}
answer($state eq "TIMED_OUT" ? "timeout" : "answered", $rc, $tail);'

# bounded SECONDS CMD... -- run CMD under a real kill deadline. PROBE_STATE is
# answered, timeout, or unknown; answered includes a non-zero return and empty
# output, with PROBE_RC preserving that distinction. PROBE_OUT is the last line
# written, which ignores login-profile chatter before our tagged answer.
PROBE_STATE=unknown
PROBE_OUT=
PROBE_RC=127
PROBE_WHY=
bounded() {
  _limit=$1
  shift
  PROBE_STATE=unknown
  PROBE_OUT=
  PROBE_RC=127
  PROBE_WHY="the command could not be started"
  if [ -z "$PERL" ]; then
    PROBE_WHY="perl is unavailable, so no bounded child can be launched"
    return 1
  fi
  _answer=$($PERL -e "$SUPERVISOR_PERL" "$_limit" "$REAP_SECONDS" "$@") || {
    PROBE_WHY="the bounded supervisor failed"
    return 1
  }
  _nl='
'
  PROBE_STATE=${_answer%%"$_nl"*}
  _answer=${_answer#*"$_nl"}
  PROBE_RC=${_answer%%"$_nl"*}
  PROBE_OUT=${_answer#*"$_nl"}
  PROBE_OUT=${PROBE_OUT%"$_nl"__DOCTOR_END__}
  case "$PROBE_STATE" in
    answered) PROBE_WHY= ;;
    timeout)  PROBE_WHY="it timed out; termination was attempted" ;;
    setup-error)
              PROBE_STATE=unknown
              PROBE_WHY="the bounded supervisor setup failed: $PROBE_OUT"
              PROBE_OUT= ;;
    supervisor-error)
              PROBE_STATE=unknown
              PROBE_WHY="the bounded supervisor failed: $PROBE_OUT"
              PROBE_OUT= ;;
    *)        PROBE_STATE=unknown
              PROBE_WHY="the bounded supervisor could not launch it" ;;
  esac
}

printf '\n=== HOST ===\n'
if command -v hostname >/dev/null 2>&1; then
  bounded "$RUN_SECONDS" hostname
  case "$PROBE_STATE:$PROBE_RC" in
    answered:0) printf '  hostname: %s\n' "${PROBE_OUT:-unknown}" ;;
    timeout:*)  printf '  hostname: COULD NOT DETERMINE — hostname timed out\n' ;;
    *)          printf '  hostname: COULD NOT DETERMINE — hostname failed\n' ;;
  esac
else
  printf '  hostname: COULD NOT DETERMINE — hostname is not available\n'
fi
printf '  user: %s\n' "${USER:-${LOGNAME:-unknown}}"
printf '  home: %s\n' "$HOME"

if command -v python3 >/dev/null 2>&1; then
  bounded "$RUN_SECONDS" python3 --version
  case "$PROBE_STATE:$PROBE_RC" in
    answered:0) printf '  python3: %s\n' "$PROBE_OUT" ;;
    timeout:*)  printf '  python3: TIMEOUT — version probe timed out; termination was attempted\n' ;;
    *)          printf '  python3: COULD NOT DETERMINE — version probe failed\n' ;;
  esac
else
  printf '  python3: ABSENT\n'
fi

if command -v git >/dev/null 2>&1; then
  bounded "$RUN_SECONDS" git --version
  case "$PROBE_STATE:$PROBE_RC" in
    answered:0) printf '  git: %s\n' "$PROBE_OUT" ;;
    timeout:*)  printf '  git: TIMEOUT — version probe timed out; termination was attempted\n' ;;
    *)          printf '  git: COULD NOT DETERMINE — version probe failed\n' ;;
  esac
else
  printf '  git: ABSENT\n'
fi

# claude usually lives behind a conda/micromamba prefix loaded by .bashrc, so a
# non-interactive shell will not see it. The measured cluster environments in
# README.md require this fallback, but their profiles are untrusted work from a
# diagnostic's perspective, so the interactive login shell gets a kill bound.
cl=$(command -v claude 2>/dev/null)
if [ -z "$cl" ]; then
  if command -v bash >/dev/null 2>&1; then
    bounded "$RUN_SECONDS" bash -lic \
      'p=$(command -v claude); if [ -n "$p" ]; then printf "found:%s\n" "$p"; else printf "absent:\n"; fi'
    case "$PROBE_STATE:$PROBE_RC:$PROBE_OUT" in
      answered:0:found:*) cl="${PROBE_OUT#found:} (login shell only)" ;;
      answered:0:absent:*) cl= ;;
      timeout:*) cl="COULD NOT DETERMINE — login shell timed out" ;;
      *) cl="COULD NOT DETERMINE — login shell probe failed" ;;
    esac
  else
    cl="COULD NOT DETERMINE — not on current PATH and bash is unavailable"
  fi
fi
printf '  claude: %s\n' "${cl:-ABSENT}"

# --- prerequisites the skills gate on ---------------------------------------
#
# ARC-265. doctor answered "installed, from here, still works" on a host where
# two prerequisites were missing, because the only thing it had ever looked at
# was the skill tree. Neither is visible from there, and a skill refuses on
# each:
#
#   * swarm.py gates every kind=code unit on `command -v paseo`. The macOS
#     install puts the CLI inside the app bundle, so the daemon can be up and
#     ~/.paseo populated while the CLI is unreachable. That is the one state a
#     reinstall does not fix and a symlink does, so the CLI and the daemon are
#     reported as TWO facts here, never as one "is it installed".
#   * `bus models` needs a registry at ~/.agent-bus/models.json. This repo
#     ships models.json at its root and installs it nowhere, and the paseo
#     skill tells skills to run `bus models --json` to route work.
#
# Every fact below is PRESENT, NOT PRESENT, or COULD NOT DETERMINE, and the
# third always says why -- survey.py's set/unrestricted/unknown rule, in the
# words a person reads. Reporting silence as absence is the quiet lie
# ARC-244, ARC-245 and ARC-251 were each about.

# Ask the daemon whether it answers, rather than whether a port is open: a
# listening socket is evidence that something is there, and only /api/health
# is evidence that it is the thing the skills talk to. A literal loopback
# address, never a name, so no probe can end up waiting on DNS.
LISTEN="${PASEO_LISTEN:-127.0.0.1:6767}"
HEALTH_PY='
import socket, sys
addr = sys.argv[1]
host, sep, port = addr.rpartition(":")
if not sep:
    host, port = "127.0.0.1", addr
if not host:
    host = "127.0.0.1"
try:
    port = int(port)
except ValueError:
    print("unknown:PASEO_LISTEN is " + addr + ", which is not host:port")
    raise SystemExit
limit = float(sys.argv[2])
try:
    s = socket.create_connection((host, port), timeout=limit)
except (socket.timeout, TimeoutError):
    print("unknown:connecting to " + addr + " timed out after %gs" % limit)
    raise SystemExit
except OSError as e:
    print("closed:" + ((e.strerror or "no connection").lower()))
    raise SystemExit
try:
    s.settimeout(limit)
    s.sendall(("GET /api/health HTTP/1.0\r\nHost: " + addr +
               "\r\nConnection: close\r\n\r\n").encode())
    head = s.recv(200).split(b"\r\n")[0].decode("ascii", "replace").strip()
except OSError:
    head = ""
finally:
    s.close()
if " 200" in head:
    print("answering:" + head)
elif head:
    print("listening:answered /api/health with " + head)
else:
    print("listening:did not answer /api/health")
'
DAEMON=unknown
WHY="no python3 here to open a socket with"
if command -v python3 >/dev/null 2>&1; then
  bounded "$PROBE_RUN_SECONDS" python3 -c "$HEALTH_PY" "$LISTEN" "$PROBE_SECONDS"
  case "$PROBE_STATE:$PROBE_RC:$PROBE_OUT" in
    answered:0:answering:*) DAEMON=up;      WHY=${PROBE_OUT#answering:} ;;
    answered:0:listening:*) DAEMON=partial; WHY=${PROBE_OUT#listening:} ;;
    answered:0:closed:*)    DAEMON=down;    WHY=${PROBE_OUT#closed:} ;;
    answered:0:unknown:*)   DAEMON=unknown; WHY=${PROBE_OUT#unknown:} ;;
    *) DAEMON=unknown; WHY="the probe was indeterminate: $PROBE_WHY" ;;
  esac
fi

printf '\n=== PREREQUISITES ===\n'

# The CLI, on PATH, because on PATH is the only form swarm.py can use: it
# calls shutil.which and refuses the unit if that is None.
cli=$(command -v paseo 2>/dev/null)
elsewhere=
if [ -z "$cli" ]; then
  for c in "$HOME/.local/bin/paseo" "$HOME/bin/paseo" \
           /usr/local/bin/paseo /opt/homebrew/bin/paseo \
           "$HOME/Applications/Paseo.app/Contents/Resources/bin/paseo" \
           /Applications/Paseo.app/Contents/Resources/bin/paseo; do
    [ -x "$c" ] || continue
    elsewhere="$c"; break
  done
fi
if [ -n "$cli" ]; then
  printf '  paseo: %s\n' "$cli"
elif [ -z "${PATH:-}" ]; then
  printf '  paseo: COULD NOT DETERMINE — PATH is empty, so finding nothing on it is not evidence of anything\n'
elif [ -n "$elsewhere" ]; then
  printf '  paseo: NOT ON PATH — the binary is at %s\n' "$elsewhere"
else
  printf '  paseo: NOT PRESENT — not on PATH, and not in any of the usual install locations\n'
fi

case "$DAEMON" in
  up)      printf '  daemon: answering at %s (%s)\n' "$LISTEN" "$WHY" ;;
  partial) printf '  daemon: something is listening at %s but %s\n' "$LISTEN" "$WHY" ;;
  down)    printf '  daemon: not running — nothing is listening at %s (%s)\n' "$LISTEN" "$WHY" ;;
  *)       printf '  daemon: COULD NOT DETERMINE at %s — %s\n' "$LISTEN" "$WHY" ;;
esac

# The combination is the finding, not either line on its own. Say it here in
# the words that end the wrong errand, because the wrong errand -- reinstall
# the app -- is what the previous version of this file sent someone on.
if [ -n "$cli" ]; then
  case "$DAEMON" in
    down) printf '      NOTE: the CLI is here but nothing is serving %s. Start the\n' "$LISTEN"
          printf '      daemon before dispatching a kind=code unit.\n' ;;
  esac
elif [ -z "${PATH:-}" ]; then
  :
else
  case "$DAEMON" in
    up|partial)
      printf '      WARNING: the daemon is up and the CLI is NOT on PATH. Paseo is\n'
      printf '      installed on this host, so reinstalling it will not change this;\n'
      printf '      the CLI ships inside the app bundle and nothing puts it on PATH.\n'
      printf '      swarm.py refuses every kind=code unit on `command -v paseo`, so\n'
      printf '      those units are dead here until the binary is linked:\n'
      if [ -n "$elsewhere" ]; then
        printf '        mkdir -p %s/.local/bin && ln -s %s %s/.local/bin/\n' \
          "$HOME" "$elsewhere" "$HOME"
      else
        printf '        (it was not in any of the usual places -- find it inside the\n'
        printf '        app bundle and link it into a directory on your PATH)\n'
      fi ;;
    down)
      printf '      NOTE: no CLI and no daemon, so kind=code units are refused here.\n'
      printf '      On a cluster login node that is the correct state: a code unit\n'
      printf '      runs a coding agent as a local process and does not belong there.\n' ;;
    *)
      printf '      NOTE: the CLI is not on PATH and the daemon could not be probed,\n'
      printf '      so whether Paseo is installed here is UNKNOWN -- not absent.\n' ;;
  esac
fi

# The registry `bus models` reads. AGENT_BUS_HOME because bin/bus honours it,
# and a report about a path the tool does not use is worth nothing.
BUS_HOME="${AGENT_BUS_HOME:-$HOME/.agent-bus}"
REG="$BUS_HOME/models.json"
COUNT_PY='
import json, sys
try:
    d = json.loads(open(sys.argv[1]).read())
except Exception as e:
    print("bad:" + type(e).__name__)
    raise SystemExit
m = d.get("models") if isinstance(d, dict) else None
print(("ok:%d" % len(m)) if isinstance(m, list) else "bad:no models list in it")
'
if [ -d "$BUS_HOME" ] && { [ ! -r "$BUS_HOME" ] || [ ! -x "$BUS_HOME" ]; }; then
  # Not readable is not empty. Whether the file is in there cannot be seen
  # from out here, and saying "absent" would be a guess wearing a fact's face.
  printf '  models registry: COULD NOT DETERMINE — %s is not readable\n' "$BUS_HOME"
elif [ -f "$REG" ] && [ -r "$REG" ]; then
  if command -v python3 >/dev/null 2>&1; then
    bounded "$RUN_SECONDS" python3 -c "$COUNT_PY" "$REG"
  else
    PROBE_STATE=unknown; PROBE_RC=127; PROBE_OUT=
    PROBE_WHY="there is no python3 here to read it with"
  fi
  case "$PROBE_STATE:$PROBE_RC:$PROBE_OUT" in
    answered:0:ok:*)  printf '  models registry: %s (%s models)\n' "$REG" "${PROBE_OUT#ok:}" ;;
    answered:0:bad:*) printf '  models registry: %s — PRESENT BUT UNUSABLE (%s)\n' \
             "$REG" "${PROBE_OUT#bad:}"
           printf '      `bus models` reports malformed or invalid content separately from absence.\n' ;;
    *)     printf '  models registry: %s — present, but its CONTENTS COULD NOT BE DETERMINED: %s\n' \
             "$REG" "$PROBE_WHY" ;;
  esac
elif [ -e "$REG" ] || [ -L "$REG" ]; then
  printf '  models registry: COULD NOT DETERMINE — %s exists but is not a readable regular file\n' "$REG"
else
  printf '  models registry: NOT PRESENT at %s\n' "$REG"
  printf '      `bus models` exits with "models registry is absent" without it, and the\n'
  printf '      paseo skill tells skills to run `bus models --json` to pick a model,\n'
  printf '      so routing has nothing to read.\n'
  if [ -f "$REPO/models.json" ]; then
    printf '      This repo ships the file that belongs there:\n'
    printf '        mkdir -p %s && cp %s/models.json %s\n' "$BUS_HOME" "$REPO" "$REG"
    printf '      install.sh deliberately does not: writing into ~/.agent-bus is a\n'
    printf '      wider footprint than installing skills, and doctor is where this\n'
    printf '      repo says what it has NOT taken ownership of.\n'
  else
    printf '      This repo normally ships models.json at its root and this checkout\n'
    printf '      has none, so there is nothing here to copy.\n'
  fi
fi

printf '\n=== SKILL STORES ===\n'
printf '  personal prefix: %s' "$PREFIX"
if [ -d "$PREFIX" ]; then
  entries=0
  for entry in "$PREFIX"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    entries=$((entries + 1))
  done
  printf ' (%s entries)\n' "$entries"
else
  printf ' — ABSENT\n'
fi

org=0
for d in "$HOME"/.claude-science/orgs/*/skills; do
  [ -d "$d" ] || continue
  for entry in "$d"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    org=$((org + 1))
  done
done
if [ "$org" -gt 0 ]; then
  printf '  org store: %s skills\n' "$org"
else
  printf '  org store: not present — personal skills must be self-sufficient here\n'
fi

printf '\n=== INSTALLED SKILLS ===\n'
if [ ! -d "$PREFIX" ]; then
  printf '  (nothing — run install.sh)\n'
else
  found=0
  for d in "$PREFIX"/*; do
    [ -e "$d" ] || continue
    name=${d##*/}
    found=$((found + 1))
    if [ -L "$d" ]; then
      if command -v readlink >/dev/null 2>&1; then
        bounded "$RUN_SECONDS" readlink "$d"
        case "$PROBE_STATE:$PROBE_RC" in
          answered:0) printf '  %-32s link -> %s\n' "$name" "$PROBE_OUT" ;;
          timeout:*)  printf '  %-32s link -> COULD NOT DETERMINE — readlink timed out\n' "$name" ;;
          *)          printf '  %-32s link -> COULD NOT DETERMINE — readlink failed\n' "$name" ;;
        esac
      else
        printf '  %-32s link -> COULD NOT DETERMINE — readlink is unavailable\n' "$name"
      fi
    elif [ -f "$d/$MARKER" ]; then
      v=
      o=
      while IFS='=' read -r key value; do
        case "$key" in
          version) v=$value ;;
          origin)  [ -n "$o" ] || o=$value ;;
        esac
      done <"$d/$MARKER"
      # "ours" was true of the FILE and misleading about the lineage: this
      # repo vendors eight skills verbatim from another author, and reporting
      # them as ours at our commit hides whose work is installed -- and hides
      # that --uninstall deliberately leaves them.
      if [ -z "$o" ] && [ -d "$REPO/skills/$name" ]; then
        case "$name" in "$OWN_PREFIX"*) o=authored ;; *) o=vendored ;; esac
      fi
      if [ "${o:-authored}" = vendored ]; then
        printf '  %-32s vendored (installed by us, written upstream; version %s)\n' \
          "$name" "${v:-?}"
      else
        printf '  %-32s ours (version %s)\n' "$name" "${v:-?}"
      fi
    else
      printf '  %-32s foreign (not installed by this repo)\n' "$name"
    fi
    case "$name" in
      *.bak|*.bak.*)
        printf '      WARNING: a .bak directory here is parsed as a skill — remove it\n' ;;
    esac
    if [ -d "$d" ] && [ ! -f "$d/SKILL.md" ]; then
      printf '      WARNING: no SKILL.md — will not load\n'
    fi
  done
  [ "$found" -eq 0 ] && printf '  (empty)\n'
fi

printf '\n=== SCRIPT HEALTH ===\n'
bad=0
for d in "$PREFIX"/*; do
  [ -d "$d" ] || continue
  for py in "$d"/scripts/*.py; do
    [ -f "$py" ] || continue
    skill=${d##*/}
    script=${py##*/}
    if ! command -v python3 >/dev/null 2>&1; then
      printf '  UNKNOWN  %s/%s — python3 is ABSENT, so compilation could not be checked\n' \
        "$skill" "$script"
      bad=$((bad + 1))
      continue
    fi
    bounded "$RUN_SECONDS" python3 -m py_compile "$py"
    if [ "$PROBE_STATE" = timeout ]; then
      printf '  TIMEOUT  %s/%s — compilation timed out; termination was attempted\n' \
        "$skill" "$script"
      bad=$((bad + 1))
    elif [ "$PROBE_STATE" != answered ]; then
      printf '  UNKNOWN  %s/%s — compilation could not be started\n' \
        "$skill" "$script"
      bad=$((bad + 1))
    elif [ "$PROBE_RC" -eq 0 ]; then
      printf '  ok    %s/%s\n' "$skill" "$script"
    else
      printf '  FAIL  %s/%s does not compile\n' "$skill" "$script"
      bad=$((bad + 1))
    fi
  done
done
[ "$bad" -eq 0 ] && printf '  (no problems)\n'

printf '\n=== SOURCE ===\n'
printf '  repo: %s\n' "$REPO"
# Ask git, never stat `.git`: it is a file in a worktree and a directory in a
# clone, and this whole section vanished for every worktree.
if command -v git >/dev/null 2>&1; then
  bounded "$RUN_SECONDS" git -C "$REPO" rev-parse --git-dir
  if [ "$PROBE_STATE:$PROBE_RC" = answered:0 ]; then
    bounded "$RUN_SECONDS" git -C "$REPO" rev-parse --short HEAD
    case "$PROBE_STATE:$PROBE_RC" in
      answered:0) printf '  commit: %s\n' "$PROBE_OUT" ;;
      timeout:*)  printf '  commit: COULD NOT DETERMINE — git timed out\n' ;;
      *)          printf '  commit: COULD NOT DETERMINE — git failed\n' ;;
    esac
    bounded "$RUN_SECONDS" git -C "$REPO" status --porcelain
    case "$PROBE_STATE:$PROBE_RC" in
      answered:0)
        if [ -n "$PROBE_OUT" ]; then
          printf '  worktree: DIRTY\n'
        else
          printf '  worktree: clean\n'
        fi ;;
      timeout:*) printf '  worktree: COULD NOT DETERMINE — git status timed out\n' ;;
      *)         printf '  worktree: COULD NOT DETERMINE — git status failed\n' ;;
    esac
  elif [ "$PROBE_STATE" = timeout ]; then
    printf '  repository: COULD NOT DETERMINE — git rev-parse timed out\n'
  fi
fi

printf '\n'
[ "$bad" -eq 0 ] || exit 1
exit 0
